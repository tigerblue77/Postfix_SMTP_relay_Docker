{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pytest)",
      "Bash(ruff check --no-cache --select F,B tests)",
      "Bash(shellcheck:*)"
    ]
  }
}
