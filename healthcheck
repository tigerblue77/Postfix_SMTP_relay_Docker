# A relay that is up but no longer signing, rewriting or logging is worse than
# one that is down: mail keeps leaving, unsigned or unlogged, and nothing says
# so. The health check therefore covers every daemon "run" started, and looks
# at postfix accepting connections rather than only at its master process.

fail()
{
    echo "$1" >&2
    exit 1
}

running()
{
    pgrep -x "$1" > /dev/null
}

# Listening sockets are read from the kernel: actually connecting every
# interval would log a connect and a lost connection each time.
listening()
{
    local hex proc=/proc/net/tcp

    printf -v hex ':%04X' "$1"
    if [ -r /proc/net/tcp6 ] ; then
      proc="$proc /proc/net/tcp6"
    fi

    # State 0A is listening, and the local address column ends with the port.
    awk -v port="$hex" '$4 == "0A" && index($2, port) { found = 1 }
                        END { exit !found }' $proc
}

running master || fail "postfix master is not running"

# Follow master.cf rather than assuming port 25, so a submission port added
# with a POSTFIXMASTER_ variable is checked too. Every inet service is looked
# at: master.cf has no field that turns one off. "maxproc 0" means no process
# count limit rather than disabled, and postfix binds the port either way; a
# service that really is disabled is removed with "postconf -MX" and postconf
# stops printing it at all.
#
# postconf is run on its own first. Inside the command substitution the loop
# used to read, a postconf that fails -- on a master.cf edited into a state it
# cannot parse -- printed nothing, the loop checked nothing, and the relay was
# reported healthy with no port looked at. And a master.cf with no inet
# service at all is a relay that accepts nothing.
services=$(postconf -M) || fail "postconf cannot read the postfix configuration, so no port was checked"
inetServices=$(awk '$2 == "inet" { print $1 }' <<< "$services")
[ -n "$inetServices" ] || fail "master.cf declares no inet service, so the relay accepts nothing"
for service in $inetServices ; do
  endpoint="${service##*:}"
  port=$(getent services "$endpoint" | awk '{ sub("/.*", "", $2) ; print $2 }')
  listening "${port:-$endpoint}" || fail "postfix is not listening on $service"
done

# A listening master is not yet a relay that works: a setting smtpd rejects
# when it reads it leaves the port open and every session killed (issue
# wader/postfix-relay#206). Start-up asks postfix for one greeting and stops
# the container without it; this asks again every five minutes, so a main.cf
# changed in a running container is caught as well (issue #14). Not at every
# check: each greeting is a connect and a disconnect in the log. "run" writes
# the address and port it greeted, and the check refreshes the file's time
# only on a 220, so a relay that stopped greeting fails every check until
# docker calls it unhealthy. One try with a short read, to stay inside the
# check's own timeout.
greeted=/run/postfix-relay.greeted
if [ -s "$greeted" ] && [ $(( $(date +%s) - $(stat -c %Y "$greeted") )) -ge 300 ] ; then
  read -r address port < "$greeted"
  greeting=$(
    {
      exec 3<>"/dev/tcp/$address/$port" || exit
      read -t 2 -r line <&3
      # QUIT, so the line left in the log is a disconnect, not a lost connection.
      printf 'QUIT\r\n' >&3
      echo "$line"
    } 2> /dev/null
  )
  case "$greeting" in
    220*) touch "$greeted" ;;
    *) fail "no smtpd greeted a connection on $address:$port: postfix is listening but cannot serve" ;;
  esac
fi

running rsyslogd || fail "rsyslogd is not running, mail is relayed unlogged"

# A variable read from a <name>_FILE is only in the environment of the
# start-up script, not in the one this check runs with, so what start-up left
# behind is what says whether a daemon is expected.
if [ -n "$OPENDKIM_DOMAINS" ] || [ -s /etc/opendkim/KeyTable ] ; then
  running opendkim || fail "opendkim is not running, mail is relayed unsigned"
fi

# The marker "run" writes at the top of the block it generates.
if [ -n "$POSTSRSD_SRS_DOMAIN" ] || grep -qs 'Generated by postfix-relay' /etc/default/postsrsd ; then
  running postsrsd || fail "postsrsd is not running, envelope senders are not rewritten"
fi

if [ -n "$SASL_Passwds" ] ; then
  running saslauthd || fail "saslauthd is not running, clients cannot authenticate"
fi
